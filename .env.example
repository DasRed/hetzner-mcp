# Hetzner Cloud API token (Hetzner Console -> project -> Security -> API tokens).
# A token with "Read" permission is enough for the default read-only mode.
HETZNER_API_TOKEN=

# Optional: separate token for Storage Boxes (falls back to HETZNER_API_TOKEN)
HETZNER_STORAGE_API_TOKEN=

# HTTP listener
HOST=0.0.0.0
PORT=3000
MCP_PATH=/mcp

# Tool groups: all or a comma separated list of
# servers, networking, load-balancers, ips, storage, storage-boxes, config, dns
MCP_SPLITS=all

# Only expose tools annotated as read-only (default: true)
MCP_READ_ONLY=true

# Optional tool name filters, comma separated, "*" as wildcard
MCP_TOOLS_ALLOW=
MCP_TOOLS_DENY=

# Optional: require "Authorization: Bearer <token>" on the MCP endpoint
MCP_AUTH_TOKEN=
