{
    "name": "@dasred/hetzner-mcp",
    "version": "1.1.2",
    "description": "Streamable HTTP MCP server for the Hetzner Cloud API, based on @lazyants/hetzner-mcp-server, packaged as a Docker image",
    "type": "module",
    "author": "Marco Starker",
    "license": "MIT",
    "private": true,
    "bugs": {
        "url": "https://github.com/dasred/hetzner-mcp/issues"
    },
    "homepage": "https://www.marco-starker.de/en/projects/hetzner-mcp/docs",
    "engines": {
        "node": ">=26.12.1",
        "npm": ">=11.20.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/dasred/hetzner-mcp.git"
    },
    "bin": {
        "hetzner-mcp": "dist/index.js"
    },
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "start": "node dist/index.js",
        "dev": "node --env-file-if-exists=.env --watch src/index.ts",
        "typecheck": "tsc -p tsconfig.test.json",
        "test": "npm run typecheck && node --test \"test/**/*.test.ts\""
    },
    "dependencies": {
        "@lazyants/hetzner-mcp-server": "^4.1.0",
        "@modelcontextprotocol/sdk": "^1.32.2"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "typescript": "^7.0.2"
    }
}
